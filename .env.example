# Keep the real .env local and mode 0600. Never commit provider credentials.
OPENAI_API_KEY=
COMPANION_TOKEN=replace-with-a-random-32-byte-token

# Current Asterisk runs in host network mode, so companion media returns locally.
ARI_URL=http://127.0.0.1:8088/ari
ARI_REQUEST_TIMEOUT_MS=5000
ARI_WS_URL=ws://127.0.0.1:8088/ari/events
ARI_USERNAME=openclaw
ARI_PASSWORD=replace-with-local-ari-password
ARI_APP=openclaw
RUNTIME_HOST=127.0.0.1
PORT=8091

# Hard safety boundary: no trunk/PSTN targets are accepted by this deployment.
ALLOWED_EXTENSIONS=1001,1002,600,700,9000
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=cedar
REALTIME_INSTRUCTIONS=Voce e Hal, assistente do Anderson. Responda em portugues do Brasil, de forma curta e natural.
REALTIME_GREETING=Oi Anderson, aqui e o Hal. Pode falar.

# Inbound calls reach the `700` dialplan extension and remain ringing until an
# authenticated admission decision. Format: E.164|known-label|relation.
# Never use a SIP display name as identity.
INBOUND_TRUSTED_CALLERS=
INBOUND_ADMISSION_TIMEOUT_MS=30000
# Periodic REST safety net for missed ARI StasisStart events; 0 disables it.
INBOUND_RECONCILIATION_INTERVAL_MS=1000
# Inbound call inactivity: warn first, then close the call if nobody resumes interaction.
INBOUND_IDLE_WARNING_MS=45000
INBOUND_IDLE_TIMEOUT_MS=60000
INBOUND_HERMES_VOICE_CONTEXT=Anderson prefers concise, natural Brazilian Portuguese replies.
# Profile-aware local webhook routes keyed by normalized *caller extension*.
# There is intentionally no fallback: unlisted callers and `default` never route.
# Keep future profiles disabled until each has its own loopback port and secret.
INBOUND_HERMES_WEBHOOK_ROUTES={"1001":{"profile":"hal","url":"http://127.0.0.1:8644/webhooks/inbound-admission","secretEnv":"INBOUND_HERMES_WEBHOOK_HAL_SECRET"},"1002":{"profile":"nova","enabled":false,"url":"","secretEnv":"INBOUND_HERMES_WEBHOOK_NOVA_SECRET"},"1003":{"profile":"kairo","enabled":false,"url":"","secretEnv":"INBOUND_HERMES_WEBHOOK_KAIRO_SECRET"}}
INBOUND_HERMES_WEBHOOK_HAL_SECRET=
INBOUND_HERMES_WEBHOOK_NOVA_SECRET=
INBOUND_HERMES_WEBHOOK_KAIRO_SECRET=
INBOUND_HERMES_WEBHOOK_TIMEOUT_MS=4000
INBOUND_HERMES_WEBHOOK_RETRIES=2
INBOUND_HERMES_WEBHOOK_RETRY_DELAY_MS=250
