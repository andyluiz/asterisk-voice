# Keep the real .env local and mode 0600. Never commit provider credentials.
OPENAI_API_KEY=
COMPANION_TOKEN=replace-with-a-random-32-byte-token

# Current Asterisk runs in host network mode, so companion media returns locally.
ARI_URL=http://127.0.0.1:8088/ari
ARI_WS_URL=ws://127.0.0.1:8088/ari/events
ARI_USERNAME=openclaw
ARI_PASSWORD=replace-with-local-ari-password
ARI_APP=openclaw
RUNTIME_HOST=127.0.0.1
PORT=8091

# Hard safety boundary: no trunk/PSTN targets are accepted by this deployment.
ALLOWED_EXTENSIONS=1001,1002,600,700,9000
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=alloy
REALTIME_INSTRUCTIONS=Voce e Hal, assistente do Anderson. Responda em portugues do Brasil, de forma curta e natural.
REALTIME_GREETING=Oi Anderson, aqui e o Hal. Pode falar.
INBOUND_GREETING=Oi, aqui e o Hal, assistente do Anderson. Como posso ajudar?
INBOUND_LANGUAGE=pt-BR
INBOUND_VOICE_CONTEXT=Somente use o contexto pessoal autorizado pelo Hermes.

# Hermes higher-function handoff. The companion sends only bounded, text-based
# requests here; the Realtime model never receives Hermes credentials.
HERMES_URL=
HERMES_PATH=/internal/voice/handoff
HERMES_TOKEN=
HERMES_PROFILE=hal
HERMES_TIMEOUT_MS=90000
HERMES_CONTEXT_CHARS=4000
