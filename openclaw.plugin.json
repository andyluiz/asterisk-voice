{
  "id": "asterisk-voice",
  "name": "Asterisk Voice",
  "description": "OpenClaw plugin for Asterisk ARI realtime voice calls without a separate runtime container.",
  "commandAliases": [{ "name": "asteriskvoice" }],
  "activation": {
    "onStartup": true,
    "onCommands": ["asteriskvoice"]
  },
  "contracts": {
    "tools": ["asterisk_voice"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "ariUrl": { "type": "string", "default": "http://127.0.0.1:8088/ari" },
      "ariWsUrl": { "type": "string" },
      "ariUsername": { "type": "string", "default": "openclaw" },
      "ariPassword": { "type": "string", "default": "openclaw-local-change-me" },
      "ariApp": { "type": "string", "default": "openclaw" },
      "defaultContext": { "type": "string", "default": "internal" },
      "defaultTo": { "type": "string", "default": "1001" },
      "externalMediaHost": { "type": "string", "default": "host.docker.internal" },
      "realtime": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "provider": { "type": "string" },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "instructions": {
            "type": "string",
            "default": "Voce e Hal, assistente do Anderson. Responda em portugues do Brasil, de forma curta e natural."
          },
          "greeting": {
            "type": "string",
            "default": "Oi Anderson, aqui e o Hal. Pode falar."
          }
        }
      }
    }
  },
  "uiHints": {
    "ariUrl": {
      "label": "ARI URL",
      "advanced": true
    },
    "ariUsername": {
      "label": "ARI Username",
      "advanced": true
    },
    "ariPassword": {
      "label": "ARI Password",
      "sensitive": true,
      "advanced": true
    },
    "defaultTo": {
      "label": "Default SIP Target"
    },
    "externalMediaHost": {
      "label": "ExternalMedia Host",
      "help": "Host name or IP that the Asterisk container can reach for RTP UDP."
    },
    "realtime.provider": {
      "label": "Realtime Voice Provider",
      "advanced": true
    },
    "realtime.providers": {
      "label": "Realtime Provider Config",
      "advanced": true
    },
    "realtime.instructions": {
      "label": "Realtime Instructions",
      "advanced": true
    },
    "realtime.greeting": {
      "label": "Realtime Greeting",
      "advanced": true
    }
  }
}
