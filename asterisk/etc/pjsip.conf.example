[global]
type=global
user_agent=Asterisk-Voice

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
# Set these to the host's LAN IP when NAT traversal is required.
external_signaling_address=LAN_HOST_IP
external_media_address=LAN_HOST_IP
local_net=LAN_SUBNET_CIDR

[1001]
type=endpoint
transport=transport-udp
context=internal
disallow=all
allow=ulaw,alaw
auth=1001-auth
aors=1001
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[1001-auth]
type=auth
auth_type=userpass
username=1001
password=REPLACE_WITH_LOCAL_SECRET

[1001]
type=aor
max_contacts=1
remove_existing=yes

[1002]
type=endpoint
transport=transport-udp
context=internal
disallow=all
allow=ulaw,alaw
auth=1002-auth
aors=1002
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[1002-auth]
type=auth
auth_type=userpass
username=1002
password=REPLACE_WITH_LOCAL_SECRET

[1002]
type=aor
max_contacts=1
remove_existing=yes
